{
  "ChatServer": {
    "Url": "https://localhost:7300"
  },
  "ChatClient": {
    "Resilience": {
      "UnaryCallTimeout": "00:00:10",
      "StreamWriteTimeout": "00:00:05",
      "StreamInitialReconnectDelay": "00:00:01",
      "StreamMaxReconnectDelay": "00:00:30",
      "StreamBackoffMultiplier": 2,
      "StreamReconnectJitter": "00:00:00.250"
    }
  },
  "ReverseTunnel": {
    "TunnelHost": "https://localhost:7300",
    "TunnelId": "chat-client",
    "Transport": "Grpc",
    "IsEnabled": true,
    "Listener": {
      "ReconnectInterval": "00:00:01",
      "MaxReconnectInterval": "00:00:05"
    },
    "RequestHeaders": {
      "X-Chat-Sample": "shared-channel"
    },
    "Grpc": {
      "ClientKeepAlivePingDelay": "00:00:30",
      "ClientKeepAlivePingTimeout": "00:00:15",
      "ServerKeepAlivePingDelay": "00:00:30",
      "ServerKeepAlivePingTimeout": "00:00:15"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
