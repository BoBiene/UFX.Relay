{
  "ReverseTunnel": {
    "TunnelHost": "https://localhost:7400",
    "TunnelId": "modern",
    "Transport": "Grpc",
    "Listener": {
      "ReconnectInterval": "00:00:01",
      "MaxReconnectInterval": "00:00:05"
    },
    "Grpc": {
      "ClientKeepAlivePingDelay": "00:00:30",
      "ClientKeepAlivePingTimeout": "00:00:15"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
